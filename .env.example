# Required for production database mode
DATABASE_URL=

# Better Auth: use a long random value in production
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon S3-compatible Object Storage. Keep all values server-only.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=uploads

# curlbrew admin access (server-only; never use NEXT_PUBLIC_)
CURLBREW_ADMIN_USERNAME=admin
CURLBREW_ADMIN_PASSWORD=change-me
CURLBREW_SESSION_SECRET=replace-with-at-least-32-random-characters
